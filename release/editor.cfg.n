node.utf8
object config
{
    string projectsPath "/home/hogsy/Projects"

    string title "Yin Game Engine"

    object fileSystem
    {
        ; This file allows you to specify which directories
        ; to mount and in what order.
        array string mountLocations
        {
            "projects/base"
        }
    }

    ; A collection of commands to automatically execute
    array string launchCommands
    {
        "editor" ; This kicks the engine into editor mode
    }
}
